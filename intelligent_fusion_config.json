{
  "enhanced_rag_config": {
    "semantic_engine": {
      "model_name": "all-MiniLM-L6-v2",
      "fallback_model": "all-mpnet-base-v2",
      "device": "auto",
      "max_sequence_length": 512
    },
    "retrieval_weights": {
      "semantic_weight": 0.5,
      "keyword_weight": 0.3,
      "context_weight": 0.2,
      "intent_boost": 0.15,
      "urgency_boost": 0.1
    },
    "filtering": {
      "min_relevance_threshold": 0.3,
      "max_results": 5,
      "diversity_threshold": 0.85
    },
    "features": {
      "enable_query_expansion": true,
      "enable_intent_filtering": true,
      "enable_context_awareness": true,
      "enable_safety_monitoring": true
    }
  },
  
  "fusion_system_config": {
    "decision_tree": {
      "crisis_intervention": {
        "strategy": "safety_first",
        "cbt_weight": 0.8,
        "icd11_weight": 0.2,
        "priority": "highest"
      },
      "symptom_inquiry": {
        "strategy": "icd11_primary",
        "cbt_weight": 0.3,
        "icd11_weight": 0.7,
        "priority": "high"
      },
      "emotional_support": {
        "strategy": "cbt_primary",
        "cbt_weight": 0.8,
        "icd11_weight": 0.2,
        "priority": "medium"
      },
      "skill_learning": {
        "strategy": "cbt_primary",
        "cbt_weight": 0.9,
        "icd11_weight": 0.1,
        "priority": "medium"
      },
      "information_seeking": {
        "strategy": "balanced_fusion",
        "cbt_weight": 0.5,
        "icd11_weight": 0.5,
        "priority": "low"
      },
      "mixed_complex": {
        "strategy": "dynamic_routing",
        "cbt_weight": 0.6,
        "icd11_weight": 0.4,
        "priority": "medium"
      }
    },
    
    "context_adjustments": {
      "urgency_boost_threshold": 4,
      "urgency_boost_amount": 0.2,
      "session_depth_balance": 0.5,
      "safety_override": true
    },
    
    "response_generation": {
      "max_response_length": 500,
      "min_confidence_threshold": 0.3,
      "enable_follow_up_suggestions": true,
      "max_follow_up_suggestions": 3,
      "enable_safety_notes": true
    }
  },
  
  "intent_classification": {
    "confidence_thresholds": {
      "crisis_intervention": 0.7,
      "emotional_support": 0.5,
      "skill_learning": 0.6,
      "symptom_assessment": 0.5,
      "treatment_guidance": 0.6,
      "information_seeking": 0.4,
      "general_chat": 0.3
    },
    
    "pattern_weights": {
      "crisis_patterns": 2.0,
      "skill_patterns": 1.5,
      "symptom_patterns": 1.2,
      "support_patterns": 1.0,
      "info_patterns": 1.0,
      "chat_patterns": 0.8
    }
  },
  
  "safety_monitoring": {
    "keywords": [
      "suicide", "kill myself", "hurt myself", "end it all", "can't go on",
      "breaking point", "not worth living", "want to die", "harm myself"
    ],
    "patterns": [
      "can't go on|breaking point|end it all",
      "hurt myself|harm myself|kill myself",
      "not worth living|want to die|take my life"
    ],
    "urgency_levels": {
      "high": ["suicide", "kill myself", "hurt myself", "end it all"],
      "medium": ["desperate", "can't cope", "breaking point"],
      "low": ["struggling", "difficult", "hard time"]
    },
    "crisis_resources": {
      "crisis_text_line": "Text HOME to 741741",
      "suicide_prevention_lifeline": "988",
      "emergency_services": "911",
      "international_helplines": "https://findahelpline.com"
    }
  },
  
  "terminology_expansion": {
    "symptom_synonyms": {
      "anxiety": ["anxious", "worried", "nervous", "panic", "fear", "stress", "tension", "apprehensive"],
      "depression": ["depressed", "sad", "down", "low", "hopeless", "empty", "mood", "melancholy"],
      "stress": ["stressed", "overwhelmed", "pressure", "burden", "strain", "tension", "overwhelm"],
      "anger": ["angry", "mad", "furious", "irritated", "frustrated", "rage", "irate"],
      "sleep": ["insomnia", "sleepless", "tired", "fatigue", "exhausted", "sleep problems"],
      "thoughts": ["thinking", "mind", "ideas", "cognition", "mental", "cognitive"],
      "behavior": ["actions", "habits", "patterns", "conduct", "response", "behavioral"]
    },
    
    "technique_synonyms": {
      "cognitive_restructuring": [
        "thought challenging", "cognitive reframing", "thinking patterns",
        "thought records", "cognitive therapy", "thought modification"
      ],
      "relaxation": [
        "breathing", "meditation", "mindfulness", "calm", "peace",
        "relaxation techniques", "stress relief", "grounding"
      ],
      "exposure": [
        "facing fears", "gradual exposure", "desensitization",
        "exposure therapy", "fear confrontation"
      ],
      "behavioral_activation": [
        "activity scheduling", "engagement", "pleasant activities",
        "behavioral activation", "activity planning"
      ]
    }
  },
  
  "knowledge_bases": {
    "cbt": {
      "index_path": "CBT_System/cbt_data/embeddings/cbt_index.faiss",
      "metadata_path": "CBT_System/cbt_data/embeddings/cbt_metadata.pkl",
      "fallback_paths": [
        "CBT_System/cbt_data/embeddings/cbt_index_*.faiss"
      ]
    },
    "icd11": {
      "index_path": "embeddings/index.faiss",
      "metadata_path": "embeddings/index.pkl",
      "fallback_paths": [
        "icd11_ch6_data/embeddings/index.faiss"
      ]
    }
  },
  
  "response_templates": {
    "icd11_primary": {
      "intro_templates": [
        "I understand you're experiencing {symptoms}. Let me provide some medical context and supportive strategies.",
        "Based on what you're describing, here's some relevant medical information along with therapeutic approaches.",
        "I can help you understand {symptoms} from both medical and therapeutic perspectives."
      ],
      "transition_phrases": [
        "From a therapeutic perspective,",
        "To complement this medical understanding,",
        "Additionally, from a CBT approach,"
      ]
    },
    
    "cbt_primary": {
      "intro_templates": [
        "I hear that you're {emotional_state}. There are effective techniques that can help.",
        "It sounds like you're dealing with {emotional_state}. Let me share some practical strategies.",
        "I understand you're feeling {emotional_state}. Here are some approaches that many people find helpful."
      ],
      "transition_phrases": [
        "It's also helpful to understand that",
        "From a medical perspective,",
        "The clinical understanding shows that"
      ]
    },
    
    "safety_first": {
      "intro_templates": [
        "I'm concerned about your safety and want to help immediately.",
        "Thank you for reaching out. Your safety is my primary concern right now.",
        "I'm here to support you through this difficult time."
      ],
      "crisis_resources_intro": [
        "If you're having thoughts of suicide or self-harm, please reach out for immediate help:",
        "Please consider contacting these crisis resources for immediate support:",
        "Right now, these resources can provide immediate help:"
      ]
    },
    
    "balanced_fusion": {
      "intro_templates": [
        "Thank you for sharing this with me. Let me provide a comprehensive understanding.",
        "I can address this from multiple perspectives to give you a complete picture.",
        "This seems like a complex situation with multiple aspects to consider."
      ],
      "integration_phrases": [
        "Connecting this information with practical approaches,",
        "Looking at this from different angles,",
        "Integrating both medical and therapeutic perspectives,"
      ]
    }
  },
  
  "context_management": {
    "conversation_memory_size": 10,
    "session_topic_tracking": true,
    "user_preference_learning": true,
    "emotional_state_tracking": true,
    "session_stages": {
      "initial": {"max_turns": 3, "focus": "assessment"},
      "ongoing": {"max_turns": 10, "focus": "intervention"},
      "deep": {"max_turns": 20, "focus": "exploration"}
    }
  },
  
  "performance_optimization": {
    "caching": {
      "enable_embedding_cache": true,
      "enable_retrieval_cache": true,
      "cache_expiry_hours": 24
    },
    "batch_processing": {
      "enable_batch_retrieval": true,
      "max_batch_size": 10
    },
    "resource_limits": {
      "max_query_length": 1000,
      "max_response_length": 2000,
      "timeout_seconds": 30
    }
  },
  
  "logging_and_monitoring": {
    "log_level": "INFO",
    "log_components": [
      "intent_classification",
      "retrieval_results",
      "fusion_decisions",
      "safety_monitoring",
      "performance_metrics"
    ],
    "metrics_tracking": {
      "response_times": true,
      "accuracy_metrics": true,
      "user_satisfaction": true,
      "safety_interventions": true
    }
  }
} 